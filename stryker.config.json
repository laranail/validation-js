{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "mutate": ["js/src/rules.ts", "js/src/paths.ts", "js/src/validate.ts"],
    "ignorePatterns": ["/vendor", "/.phpunit.cache", "/dist"],
    "testRunner": "command",
    "commandRunner": { "command": "node --test \"js/tests/**/*.test.ts\"" },
    "reporters": ["clear-text", "progress"],
    "coverageAnalysis": "off",
    "tempDirName": ".stryker-tmp"
}

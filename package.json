{
    "name": "@laranail/validation-js",
    "version": "1.0.0",
    "description": "Validate a form in the browser against a schema exported from Laravel's own validation rules. Zero dependencies.",
    "keywords": [
        "laravel",
        "validation",
        "forms",
        "client-side"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/validation-js",
    "repository": {
        "type": "git",
        "url": "https://github.com/laranail/validation-js.git"
    },
    "bugs": {
        "url": "https://github.com/laranail/validation-js/issues"
    },
    "license": "MIT",
    "author": "Simtabi LLC <opensource@simtabi.com>",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./regex": {
            "types": "./dist/regex.d.ts",
            "default": "./dist/regex.js"
        },
        "./react": {
            "types": "./dist/adapters/react.d.ts",
            "default": "./dist/adapters/react.js"
        },
        "./vue": {
            "types": "./dist/adapters/vue.d.ts",
            "default": "./dist/adapters/vue.js"
        },
        "./alpine": {
            "types": "./dist/bridges/alpine.d.ts",
            "default": "./dist/bridges/alpine.js"
        },
        "./autoboot": {
            "types": "./dist/bridges/autoboot.d.ts",
            "default": "./dist/bridges/autoboot.js"
        },
        "./debug": {
            "types": "./dist/debug.d.ts",
            "default": "./dist/debug.js"
        }
    },
    "peerDependencies": {
        "react": "^18.0 || ^19.0",
        "vue": "^3.3"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "npm run build",
        "typecheck": "tsc --noEmit",
        "format": "biome format --write js",
        "format:check": "biome format js",
        "test": "npm run typecheck && node --test \"js/tests/**/*.test.ts\"",
        "test:pack": "bash js/tests/pack-import-check.sh",
        "prepublishOnly": "npm test && npm run test:pack",
        "test:e2e": "playwright test",
        "budget": "node scripts/bundle-budget.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@biomejs/biome": "^2.5.10",
        "@playwright/test": "^1.62.1",
        "@stryker-mutator/core": "^10.0.0",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "alpinejs": "^3.16.2",
        "esbuild": "^0.28.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "^7.0.2",
        "vue": "^3.5.41"
    },
    "browserslist": [
        "Safari >= 15.4",
        "iOS >= 15.4",
        "Chrome >= 93",
        "Firefox >= 92",
        "Edge >= 93"
    ]
}

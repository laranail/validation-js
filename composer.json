{
    "name": "laranail/validation-js",
    "description": "Export Laravel validation rules as a JSON schema, and validate against it in the browser with no round trip.",
    "keywords": [
        "laravel",
        "validation",
        "javascript",
        "client-side"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/validation-js",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/validation-js/issues",
        "source": "https://github.com/laranail/validation-js",
        "docs": "https://opensource.simtabi.com/documentation/laranail/validation-js/"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/validation"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "laranail/package-tools": "^0.1",
        "laranail/console": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.3",
        "laranail/validation": "^0.1",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0||^4.4.5",
        "pestphp/pest-plugin-laravel": "^3.0||^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "laranail/validation": "^1.0 (PHP 8.5) or ^0.1.1 (PHP 8.4) \u2014 export straight from a RuleSet instead of a plain rules array."
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\ValidationJs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\ValidationJs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse",
        "format": "@pint-fix",
        "pint": "vendor/bin/pint --test --config vendor/laranail/package-tools/pint.json",
        "pint-fix": "vendor/bin/pint --parallel --config vendor/laranail/package-tools/pint.json",
        "lint": [
            "@pint",
            "@phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\ValidationJs\\Providers\\ValidationJsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
